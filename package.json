{
  "name": "portafolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tippyjs/react": "^4.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tippy.js": "^6.3.7",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "sintax:test": "prettier --check \"{,!(node_modules|build)/**/}*.(jsx|css)\"",
    "sintax:fix": "prettier --write \"{,!(node_modules|build)/**/}*.(jsx|css)\"",
    "lint": "eslint .",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "predeploy": "npm run check && npm run build",
    "deploy": "gh-pages -d build",
    "check": "npm run sintax:test && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
